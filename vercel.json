{
  "crons": [
    {
      "path": "/api/criafy-scheduler-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/criafy-metrics-sync-cron",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
